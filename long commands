**MOBILE-download all the apk packages - apart from 3rd party APKs**

adb shell pm list packages -f | sed 's/package://' | while IFS='=' read apk pkg; do
      echo "[+] Downloading $pkg"
      adb pull "$apk" "apks/${pkg}.apk"
done
